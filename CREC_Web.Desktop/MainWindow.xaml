<Window x:Class="CREC_Web.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CREC Desktop"
        Width="1400"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        Icon="/CREC.ico">
    <Window.Resources>
        <Style x:Key="RoundedBlueButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 角丸の背景（青色 #0078F2） -->
                        <Border x:Name="buttonBorder"
                            Background="#0078F2"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- トリガー（状態に応じた色変更） -->
                        <ControlTemplate.Triggers>
                            <!-- マウスオーバーで少し暗く -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#005EC4"/>
                            </Trigger>
                            <!-- クリック（押下）でさらに暗く -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#004B9B"/>
                            </Trigger>
                            <!-- ボタンが無効（Disabled）な時のグレーアウト -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,12,12,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="OpenProjectButton"
                        Click="BrowseButton_Click"
                        Content="プロジェクトを開く"
                        DockPanel.Dock="Left"
                        Style="{StaticResource RoundedBlueButtonStyle}" />
                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <TextBlock VerticalAlignment="Center"
                               Text="ポート:" />
                    <TextBox x:Name="PortTextBox"
                             Width="72"
                             Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             Text="5000" />
                </StackPanel>
                <CheckBox x:Name="PublishCheckBox"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Click="PublishCheckBox_Click"
                          DockPanel.Dock="Left"
                          Content="Webサーバーとして公開する" />
                <Button x:Name="BrowserBackButton"
                        Width="70"
                        Click="BrowserBackButton_Click"
                        Content="戻る"
                        DockPanel.Dock="Right"
                        IsEnabled="{Binding ElementName=Browser, Path=CanGoBack}"
                        Style="{StaticResource RoundedBlueButtonStyle}" />
            </DockPanel>
        </Border>

        <Border x:Name="BrowserHost"
                Grid.Row="1"
                Visibility="Collapsed">
            <wv2:WebView2 x:Name="Browser" />
        </Border>

        <Border x:Name="LoadingHost"
                Grid.Row="1"
                Background="White"
                Visibility="Collapsed">
            <TextBlock x:Name="LoadingTextBlock"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#374151"
                       Text="読み込み中..." />
        </Border>
    </Grid>
</Window>
