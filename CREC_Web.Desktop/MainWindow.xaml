<Window x:Class="CREC_Web.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CREC Web Desktop"
        Width="1400"
        Height="900"
        MinWidth="960"
        MinHeight="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBarTray Margin="0,0,0,8"
                    IsLocked="True">
            <ToolBar>
                <Button x:Name="OpenProjectButton"
                       Click="BrowseButton_Click"
                       Content="プロジェクトを開く" />
                <Separator />
                <TextBlock VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="起動設定:" />
                <CheckBox x:Name="PublishCheckBox"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         Click="PublishCheckBox_Click"
                         Content="Webサーバーとして公開する" />
            </ToolBar>
        </ToolBarTray>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="12,8"
                Background="#FFF5F7FA"
                BorderBrush="#FFD0D7DE"
                BorderThickness="1"
                CornerRadius="4">
            <WrapPanel>
                <TextBlock VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="状態" />
                <TextBlock Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Text="プロジェクト:" />
                <TextBlock x:Name="ProjectNameTextBlock"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Text="-" />
                <TextBlock Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Text="HTTP ポート:" />
                <TextBlock x:Name="PortTextBlock"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Text="-" />
                <TextBlock Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Text="状態:" />
                <TextBlock x:Name="StatusTextBlock"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Text="未起動" />
            </WrapPanel>
        </Border>

        <Border x:Name="BrowserHost"
                Grid.Row="2"
                BorderBrush="#FFD0D7DE"
                BorderThickness="1"
                Visibility="Collapsed">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
    </Grid>
</Window>
