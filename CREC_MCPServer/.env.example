# CREC MCPServer Environment Configuration Reference
# server.py reads process environment variables directly and does not load this
# file or a .env file automatically. Set the required values in the shell,
# service definition, or launch configuration before starting server.py.
#
# The values below are an Ollama configuration example. The built-in defaults
# in server.py target LM Studio at http://localhost:1234 with
# google/gemma-4-e2b.

# LLM backend URL (Ollama / LM Studio / any OpenAI-compatible API)
LLM_URL=http://localhost:11434

# Model name to use (for Ollama, specify a model that has been pulled)
LLM_MODEL=llama3.2

# MCP server bind address (usually no change needed)
MCP_HOST=127.0.0.1

# MCP server port number (must match McpServer:Url in CREC Web's appsettings.json)
MCP_PORT=8765

# LLM request timeout (seconds)
LLM_TIMEOUT=120

# Maximum characters of page context to inject into the system prompt.
# Reduce this value if the model's context window is small.
# (If you encounter n_keep >= n_ctx 400 errors, try lowering to ~1200.)
MAX_CONTEXT_CHARS=3000

# Maximum number of conversation history turns (user+assistant pairs) sent to the LLM.
# Older turns are dropped when they don't fit in the context window.
# With an 8192-token context, the system prompt occupies 3000-5000 tokens,
# so 10 turns (20 messages) is a safe upper limit. Lower this if conversations
# become unstable.
MAX_HISTORY_TURNS=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log file output directory (absolute path or relative to CWD)
# CHAT_LOG_DIR=logs

# Log file retention period in days (0 = unlimited)
# CHAT_LOG_RETENTION_DAYS=90

# Maximum character length per field in log entries (truncates large contexts)
# CHAT_LOG_MAX_FIELD_LENGTH=10000

# ---------------------------------------------------------------------------
# Whitelists (optional)
# ---------------------------------------------------------------------------

# The following are optional. If not set, the default whitelists are used.
# Button ID whitelist (comma-separated)
# SAFE_BUTTON_IDS=addNewCollectionBtn,editProjectBtn,...

# Form field ID whitelist (comma-separated)
# SAFE_INPUT_IDS=operationType,operationQuantity,...
